# Dev: scripts/worktree-env.sh writes these four to .env.local for this worktree. Add your own lines below them.
# Server: /srv/jakamarinko/.env (infra/README.md); web, api and worker all read it.

# Web dev server port (dev only)
WEB_PORT=3000
# Api port in dev; production uses PORT=3000 from the Dockerfile
API_PORT=3001
# The api as the web server reaches it: dev proxies /api here; server-side calls (session checks) use it everywhere.
# Server: API_URL=http://api:3000 (the browser's /api still goes through Traefik)
API_URL=http://localhost:3001
# Postgres; dev: one database per worktree in the Postgres from dev/compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:54320/jm_your_branch

# Dev console email transport writes here (default: .emails in the process directory)
# EMAIL_OUTBOX_DIR=.emails

# Legal pages (T17) show a "Draft, not yet in force" banner until this is true. Set it only after legal review.
# LEGAL_APPROVED=false

# Auth (packages/auth). The site's public origin; dev default: http://localhost:$WEB_PORT
# BETTER_AUTH_URL=https://jakamarinko.com
# Required in production, 32+ characters: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Google sign-in; without both the Google button is hidden. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Seeded on api start (safe to repeat): owner, head coach (Jaka), and the default location's address.
# Each one missing is skipped with a warning; the api still starts.
# OWNER_EMAIL=
# HEAD_COACH_EMAIL=
# LAB_ADDRESS=

# Set by the Dockerfile images; not needed in .env
# NODE_ENV=production
# Port the api and web containers listen on (dev uses API_PORT / WEB_PORT instead)
# PORT=3000
# Where the api image finds its migrations (from source the db package finds its own folder)
# MIGRATIONS_DIR=/app/drizzle
# Email transport: console (default; nothing is sent) or smtp. Bad smtp settings fall back to console with a warning.
# EMAIL_TRANSPORT=console
# Sender, required for smtp
# EMAIL_FROM="Jaka Marinko <noreply@jakamarinko.com>"
# SMTP server; dev: the Mailpit from dev/compose.yml (localhost, 1025, inbox at http://localhost:8025)
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_SECURE=false   # true for port 465
# SMTP_USER=
# SMTP_PASS=
# Tags (T05), read by the api at runtime; leave empty to turn one off. Umami is cookieless and runs before consent,
# Meta and Google load only after marketing consent.
UMAMI_URL=
UMAMI_WEBSITE_ID=
META_PIXEL_ID=
GOOGLE_TAG_ID=
# Booking (T07). Defaults shown; times are in Europe/Ljubljana.
# Minutes kept free between two bookings
# BOOKING_BUFFER_MIN=15
# How soon a customer can book, and how far ahead
# BOOKING_NOTICE_HOURS=24
# BOOKING_HORIZON_DAYS=60
# Customers can cancel for free until this many hours before the start
# BOOKING_CANCEL_HOURS=24
# Online payment (T13). Until it is true, bookings are confirmed right away and paid on site.
# PAYMENTS_ENABLED=false
